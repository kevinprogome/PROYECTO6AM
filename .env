# Proyecto: GreenHouse Manager
# Archivo: .env
# Descripcion: Variables de entorno locales.
# Autor: Equipo GreenHouse Manager
# Fecha: 2026-05-06
# Version: 1.0.0

# Backend
JWT_SECRET=change-me-please-32-characters-min
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_REDIRECT_URI=http://localhost:5173/login
SERVER_PORT=8080

# Database
DB_NAME=greenhouse
DB_USER=greenhouse
DB_PASSWORD=greenhouse
DB_ROOT_PASSWORD=greenhouse

# OAuth2 (solo para desarrollo)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_URL=

# API tests
API_URL=http://localhost:8080
TEST_USER_EMAIL=qa@greenhouse.local
TEST_USER_ROLE=ADMIN

# Taiga
TAIGA_API_URL=https://api.taiga.io/api/v1
TAIGA_PROJECT=1789694
TAIGA_TOKEN=your-taiga-token
TAIGA_UI_URL=https://tree.taiga.io
TAIGA_STORIES_PATH=scripts/taiga_stories.json
TAIGA_REPORT_PATH=docs/TAIGA.md
